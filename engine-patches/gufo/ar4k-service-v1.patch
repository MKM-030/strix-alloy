+void TestServicePendingLimitRejectsBeforeStateAdmission() {
+  auto control = std::make_shared<FakeControl>();
+  control->max_context = 4096;
+  control->block_advance_label = 1;
+  auto scheduler = MakeScheduler(control, 1, {}, ServicePolicy());
+
+  auto active = scheduler->Submit({1}, 4, 0.0F, {}, false,
+                                  ServiceMetadata("active-client"));
+  control->WaitForAdvance(1);
+  auto queued = scheduler->Submit({2}, 1, 0.0F, {}, false,
+                                  ServiceMetadata("queued-client"));
+
+  bool rejected = false;
+  try {
+    (void)scheduler->Submit({3}, 1, 0.0F, {}, false,
+                            ServiceMetadata("third-client"));
+  } catch (const TextGenerationError& error) {
+    rejected = error.code() == TextGenerationErrorCode::kQueueFull;
+  }
+  Expect(rejected, "restricted pending queue rejects third request");
+  Expect(control->states_created.load(std::memory_order_relaxed) == 1,
+         "restricted queue rejection creates no second state");
+
+  control->ReleaseAdvance();
+  const auto active_result = active.Wait();
+  const auto queued_result = queued.Wait();
+  Expect(active_result.tokens == ExpectedTokens(1, 4) &&
+             queued_result.tokens == ExpectedTokens(2, 1),
+         "restricted active and queued work both drain");
+  const auto repeat =
+      scheduler
+          ->Submit({1}, 1, 0.0F, {}, false, ServiceMetadata("active-client"))
+          .Wait();
+  Expect(
+      !active_result.cache_hit && !queued_result.cache_hit && !repeat.cache_hit,
+      "restricted repeated prompt never uses cache");
+}
