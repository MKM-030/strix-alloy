+void TestChatPolicy() {
+  PolicyBackend backend;
+  const auto make_body = [](std::string_view field) {
+    return std::string{
+               "{\"model\":\"test-model\",\"messages\":[{\"role\":\"user\","
+               "\"content\":\"hello\"}],"} +
+           std::string(field) + "}";
+  };
+  for (const auto output : {"1", "256"}) {
+    const auto response = HandleOpenAiChat(
+        Chat(make_body(std::string{"\"max_tokens\":"} + output)), backend);
+    Expect(response.status == 200, "service chat accepts output 1/256");
+    Expect(!backend.last_cache, "service chat disables cache by default");
+  }
+  for (const auto output : {"257", "0", "-1", "1.5", "\"1\"", "true"}) {
+    const auto before = backend.runner.prepare_calls;
+    const auto response = HandleOpenAiChat(
+        Chat(make_body(std::string{"\"max_tokens\":"} + output)), backend);
+    Expect(response.status == 400, "service chat rejects invalid output");
+    Expect(backend.runner.prepare_calls == before,
+           "invalid output refused before preparation");
+  }
+  for (const auto field :
+       {"\"max_tokens\":4000,\"max_completion_tokens\":1",
+        "\"max_tokens\":1,\"max_completion_tokens\":2", "\"cache_prompt\":true",
+        "\"thinking\":{\"type\":\"enabled\"}", "\"reasoning_effort\":\"low\"",
+        "\"chat_template_kwargs\":{\"preserve_thinking\":true}",
+        "\"chat_template_kwargs\":{\"add_vision_id\":true}"}) {
+    const auto before = backend.runner.prepare_calls;
+    const auto response = HandleOpenAiChat(Chat(make_body(field)), backend);
+    Expect(response.status == 400, "service chat rejects forbidden field");
+    Expect(backend.runner.prepare_calls == before,
+           "forbidden field refused before preparation");
+  }
+  const auto oversized =
+      HandleOpenAiChat(Chat(make_body("\"max_tokens\":256")), backend);
+  Expect(oversized.status == 200, "2304 rendered tokens accepted");
+  backend.runner.prepared_tokens = 2305;
+  const auto before = backend.admitted_calls;
+  const auto response = HandleOpenAiChat(
+      Chat(make_body("\"max_tokens\":256,\"stream\":true")), backend);
+  Expect(response.status == 400 && !response.streaming_body,
+         "oversized stream refused synchronously");
+  Expect(backend.admitted_calls == before, "oversized prompt never admitted");
+
+  const auto pass_alias = HandleOpenAiChat(
+      Chat(make_body("\"max_tokens\":256,\"max_completion_tokens\":256")),
+      backend);
+  Expect(pass_alias.status == 400,
+         "2305 rendered tokens still refused with equal aliases");
+  backend.runner.prepared_tokens = 2304;
+  Expect(
+      HandleOpenAiChat(
+          Chat(make_body("\"max_tokens\":256,\"max_completion_tokens\":256")),
+          backend)
+              .status == 200,
+      "equal aliases accepted");
+  Expect(
+      HandleOpenAiChat(
+          Chat(make_body("\"max_tokens\":null,\"max_completion_tokens\":256")),
+          backend)
+              .status == 200,
+      "null alias ignored");
+  Expect(HandleOpenAiChat(Chat(make_body("\"cache_prompt\":false")), backend)
+                 .status == 200,
+         "explicit cache=false accepted");
+  Expect(
+      HandleOpenAiChat(
+          Chat(
+              R"({"model":"test-model","messages":[{"role":"user","content":"hello"}]})"),
+          backend)
+                  .status == 200 &&
+          backend.last_output == 256,
+      "omitted output uses validated backend default");
+
+  const auto before_features = backend.runner.prepare_calls;
+  const auto history = HandleOpenAiChat(
+      Chat(
+          R"({"model":"test-model","messages":[{"role":"assistant","content":"hello","reasoning_content":"hidden"},{"role":"user","content":"next"}],"max_tokens":1})"),
+      backend);
+  Expect(history.status == 400 &&
+             history.body.find("reasoning history") != std::string::npos,
+         "reasoning history refused");
+  const auto image = HandleOpenAiChat(
+      Chat(
+          R"({"model":"test-model","messages":[{"role":"user","content":[{"type":"image_url","image_url":{"url":"file:///Z:/nonexistent-policy-test.jpg"}}]}],"max_tokens":1})"),
+      backend);
+  Expect(image.status == 400 &&
+             image.body.find("forbids vision") != std::string::npos &&
+             image.body.find("request_policy_violation") != std::string::npos,
+         "image URL refused by policy before file reading");
+  Expect(backend.runner.prepare_calls == before_features,
+         "history and image refused before preparation");
+}
