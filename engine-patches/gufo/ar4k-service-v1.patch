+void TestDirectRoutes() {
+  PolicyBackend backend;
+  struct Case {
+    std::string_view path;
+    std::string_view body;
+    std::string_view output_field;
+  };
+  constexpr Case framed[]{
+      {"/v1/chat/completions",
+       R"({"model":"test-model","messages":[{"role":"user","content":"hello"}],"max_tokens":256})",
+       "max_tokens"},
+      {"/v1/responses",
+       R"({"model":"test-model","input":"hello","max_output_tokens":256})",
+       "max_output_tokens"},
+      {"/v1/messages",
+       R"({"model":"test-model","messages":[{"role":"user","content":"hello"}],"max_tokens":256})",
+       "max_tokens"},
+  };
+  for (const auto& route : framed) {
+    auto body = gufo::json::parse(route.body);
+    for (const int output : {1, 256}) {
+      body[std::string(route.output_field)] = output;
+      Expect(Route(std::string(route.path), body, backend).status == 200,
+             "framed route accepts output 1/256");
+      Expect(backend.last_output == static_cast<std::size_t>(output) &&
+                 !backend.last_cache,
+             "framed route passes output and cache=false");
+    }
+    for (const auto& bad : {"257", "0", "-1", "1.5", "\"1\"", "true"}) {
+      body[std::string(route.output_field)] = gufo::json::parse(bad);
+      const auto before = backend.runner.prepare_calls;
+      Expect(Route(std::string(route.path), body, backend).status == 400,
+             "framed route rejects output outside service range");
+      Expect(backend.runner.prepare_calls == before,
+             "invalid output refused before preparation");
+    }
+    body[std::string(route.output_field)] = 256;
+    backend.runner.prepared_tokens = 2305;
+    const auto before = backend.admitted_calls;
+    Expect(Route(std::string(route.path), body, backend).status == 400,
+           "framed route rejects 2305 prepared tokens");
+    Expect(backend.admitted_calls == before,
+           "oversized prepared prompt never admitted");
+    backend.runner.prepared_tokens = 2304;
+    Expect(Route(std::string(route.path), body, backend).status == 200,
+           "framed route accepts 2304 prepared tokens");
+  }
+  for (
+      const auto& omitted :
+      {Case{"/v1/responses", R"({"model":"test-model","input":"hello"})",
+            "max_output_tokens"},
+       Case{
+           "/v1/messages",
+           R"({"model":"test-model","messages":[{"role":"user","content":"hello"}]})",
+           "max_tokens"}}) {
+    const auto response = Route(std::string(omitted.path),
+                                gufo::json::parse(omitted.body), backend);
+    Expect(response.status == 200 && backend.last_output == 256,
+           "compatibility route uses validated default output");
+  }
+  {
+    auto body = gufo::json::parse(framed[1].body);
+    body["max_output_tokens"] = gufo::json::Value();
+    Expect(Route("/v1/responses", body, backend).status == 400,
+           "compatibility token field remains nonnullable");
+  }
+  for (const auto& route : {framed[0], framed[1]}) {
+    auto body = gufo::json::parse(route.body);
+    body["stream"] = true;
+    body[std::string(route.output_field)] = 257;
+    const auto output_error = Route(std::string(route.path), body, backend);
+    Expect(output_error.status == 400 && !output_error.streaming_body,
+           "stream output violation returns immediate 400");
+    body[std::string(route.output_field)] = 256;
+    backend.runner.prepared_tokens = 2305;
+    const auto input_error = Route(std::string(route.path), body, backend);
+    Expect(input_error.status == 400 && !input_error.streaming_body,
+           "stream input violation returns immediate 400");
+    backend.runner.prepared_tokens = 2304;
+  }
+
+  for (const auto& raw :
+       {Case{"/v1/completions",
+             R"({"model":"test-model","prompt":"hello","max_tokens":1})",
+             "max_tokens"},
+        Case{"/completion", R"({"prompt":"hello","n_predict":1})",
+             "n_predict"}}) {
+    const auto response =
+        Route(std::string(raw.path), gufo::json::parse(raw.body), backend);
+    Expect(
+        response.status == 400 &&
+            response.body.find("request_policy_violation") != std::string::npos,
+        "raw route returns explicit policy refusal");
+    Expect(backend.raw_calls == 0,
+           "raw route never reaches backend completion");
+  }
+
+  for (const auto& route : framed) {
+    auto body = gufo::json::parse(route.body);
+    body["cache_prompt"] = true;
+    const auto before = backend.runner.prepare_calls;
+    Expect(Route(std::string(route.path), body, backend).status == 400,
+           "compatibility and chat cache=true refused");
+    Expect(backend.runner.prepare_calls == before,
+           "cache=true refused before preparation");
+    body["cache_prompt"] = false;
+    Expect(Route(std::string(route.path), body, backend).status == 200,
+           "explicit compatibility cache=false accepted");
+  }
+  {
+    auto body = gufo::json::parse(framed[1].body);
+    body["reasoning"] = gufo::json::Value::object();
+    Expect(Route("/v1/responses", body, backend).status == 400,
+           "compatibility reasoning field remains unsupported");
+  }
+  {
+    const auto before = backend.runner.prepare_calls;
+    const auto reasoning = gufo::json::parse(
+        R"({"model":"test-model","input":[{"type":"reasoning","summary":[{"type":"summary_text","text":"hidden"}]},{"role":"assistant","content":"hello"},{"role":"user","content":"next"}],"max_output_tokens":1})");
+    Expect(Route("/v1/responses", reasoning, backend).status == 400,
+           "responses reasoning history refused");
+    Expect(backend.runner.prepare_calls == before,
+           "responses history refused before preparation");
+    const auto image = gufo::json::parse(
+        R"({"model":"test-model","input":[{"role":"user","content":[{"type":"image_url","image_url":"file:///Z:/nonexistent-policy-test.jpg"}]}],"max_output_tokens":1})");
+    Expect(Route("/v1/responses", image, backend).status == 400,
+           "compatibility image form stays rejected");
+    Expect(backend.runner.prepare_calls == before,
+           "compatibility image refused before preparation");
+  }
+  Expect(HandleTextCompatibilityRequest(Chat("{}"), backend).status == 404,
+         "compatibility dispatcher preserves not-found response");
+
+  backend.policy = TextRequestPolicy::kDefault;
+  for (const auto& route : framed) {
+    auto body = gufo::json::parse(route.body);
+    body[std::string(route.output_field)] = 257;
+    Expect(Route(std::string(route.path), body, backend).status == 200,
+           "unrestricted route accepts 257 output");
+    Expect(backend.last_cache, "unrestricted route preserves cache default");
