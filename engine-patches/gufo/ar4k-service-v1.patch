+HttpResponse Route(std::string path, const gufo::json::Value& body,
+                   PolicyBackend& backend) {
+  auto request = Chat(body.dump());
+  request.path = std::move(path);
+  if (request.path == "/v1/chat/completions")
+    return HandleOpenAiChat(request, backend);
+  return HandleTextCompatibilityRequest(request, backend);
+}
