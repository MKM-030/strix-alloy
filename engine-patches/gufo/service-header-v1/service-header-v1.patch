+
+class ScopedTemporaryDirectory final {
+public:
+  ScopedTemporaryDirectory(const std::filesystem::path& parent,
+                           std::string_view prefix) {
+    for (std::size_t suffix = 0; suffix < 4096; ++suffix) {
+      auto candidate =
+          parent / (std::string(prefix) + "-" + std::to_string(suffix));
+      std::error_code error;
+      if (std::filesystem::create_directory(candidate, error)) {
+        path_ = std::move(candidate);
+        return;
+      }
+      if (std::filesystem::exists(candidate))
+        continue;
+      throw std::filesystem::filesystem_error(
+          "cannot create exclusive test directory", candidate, error);
+    }
+    throw std::runtime_error("cannot reserve a unique test directory");
+  }
+
+  ScopedTemporaryDirectory(const ScopedTemporaryDirectory&) = delete;
+  ScopedTemporaryDirectory& operator=(const ScopedTemporaryDirectory&) = delete;
+
+  ~ScopedTemporaryDirectory() {
+    std::error_code ignored;
+    for (const auto& file : files_)
+      std::filesystem::remove(file, ignored);
+    std::filesystem::remove(path_, ignored);
+  }
+
+  const std::filesystem::path& path() const { return path_; }
+
+  void TrackFile(const std::filesystem::path& file) {
+    if (file.parent_path() != path_)
+      throw std::invalid_argument("test file must be inside owned directory");
+    files_.push_back(file);
+  }
+
+private:
+  std::filesystem::path path_;
+  std::vector<std::filesystem::path> files_;
+};
