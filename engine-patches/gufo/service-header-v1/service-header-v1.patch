+constexpr std::size_t kMetadataLimit = 16 * 1024 * 1024;
+constexpr std::size_t kFixtureLimit = 1024 * 1024;
+constexpr std::size_t kBodyLimit = 16 * 1024;
+constexpr std::size_t kRenderedLimit = 32 * 1024;
