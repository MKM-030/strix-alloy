+class PreparationRunner final : public server::TextModelRunner {
+public:
+  explicit PreparationRunner(const tokenization::QwenTokenizer* tokenizer)
+      : tokenizer_(tokenizer) {}
+
+  server::TextRunnerDescriptor Descriptor() const override {
+    return {.model_id = "gufo-flash-next",
+            .state_abi = "offline-preparation-only",
+            .max_context = 4096,
+            .capabilities = {},
+            .persistence = std::nullopt};
+  }
+  server::TextRunnerResourceClaim ResourceClaim() const override { return {}; }
+  std::vector<server::TextExecutionPlan> SupportedPlans() const override {
+    return {
+        {.kind = server::TextExecutionPlanKind::kSerial, .physical_width = 1}};
+  }
+  std::vector<server::TextRunnerToken> Tokenize(
+      std::string_view text) const override {
+    if (!tokenizer_)
+      throw std::logic_error("tokenizer is unavailable");
+    return tokenizer_->Encode(text);
+  }
+  std::optional<std::vector<server::TextRunnerToken>> RenderAndTokenize(
+      const server::ChatRequest& request) const override {
+    const auto prepared = PreparePrompt(request);
+    if (!prepared)
+      return std::nullopt;
+    return prepared->tokens;
+  }
+  std::optional<server::TextPreparedPrompt> PreparePrompt(
+      const server::ChatRequest& request) const override {
+    ++prepare_calls;
+    captured = request;
+    if (!tokenizer_)
+      throw std::logic_error("tokenizer is unavailable");
+    auto options = tokenization::ResolveQwenChatOptions(request.reasoning,
+                                                        request.add_vision_id);
+    options.require_tool_call =
+        request.tool_choice == server::ChatRequest::ToolChoice::kRequired;
+    options.max_output_bytes = kRenderedLimit;
+    const std::span<const tokenization::ChatTool> tools =
+        request.tool_choice == server::ChatRequest::ToolChoice::kNone
+            ? std::span<const tokenization::ChatTool>{}
+            : std::span<const tokenization::ChatTool>{request.tools};
+    std::string error;
+    auto rendered = tokenization::QwenChatTemplate::Render(
+        request.messages, tools, options, &error);
+    if (!rendered)
+      throw std::invalid_argument("prompt rendering failed: " + error);
+    rendered_prompt = std::move(*rendered);
+    auto tokens = tokenization::QwenChatTemplate::RenderAndTokenize(
+        *tokenizer_, request.messages, tools, options, &error);
+    if (!tokens)
+      throw std::invalid_argument("prompt tokenization failed: " + error);
+    prepared_tokens = *tokens;
+    return server::TextPreparedPrompt{std::move(*tokens), {}};
+  }
+  std::string Decode(std::span<const server::TextRunnerToken>) const override {
+    throw std::logic_error("offline fixture forbids decoding");
+  }
+  std::unique_ptr<server::TextRunnerState> CreateState() const override {
+    throw std::logic_error("offline fixture forbids inference state");
+  }
+  server::TextPrefillStep Prefill(server::TextRunnerState&,
+                                  std::span<const server::TextRunnerToken>,
+                                  std::size_t, std::size_t) const override {
+    throw std::logic_error("offline fixture forbids prefill");
+  }
+  server::TextDecodeSelection SelectNext(
+      server::TextRunnerState&, sampling::SamplerState&) const override {
+    throw std::logic_error("offline fixture forbids selection");
+  }
+  void Advance(server::TextRunnerState&,
+               server::TextRunnerToken) const override {
+    throw std::logic_error("offline fixture forbids advancement");
+  }
+  std::size_t CheckpointPosition(
+      const server::TextRunnerState&) const override {
+    throw std::logic_error("offline fixture forbids checkpoints");
+  }
+
+  mutable std::size_t prepare_calls{0};
+  mutable server::ChatRequest captured;
+  mutable std::string rendered_prompt;
+  mutable std::vector<server::TextRunnerToken> prepared_tokens;
+
+private:
+  const tokenization::QwenTokenizer* tokenizer_;
+};
