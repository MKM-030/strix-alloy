+std::string Sha256(std::string_view value) {
+  return crypto::Sha256Hex(
+      {reinterpret_cast<const std::uint8_t*>(value.data()), value.size()});
+}
+
+std::vector<std::uint8_t> ReadBounded(const std::filesystem::path& path,
+                                      std::size_t limit) {
+  std::ifstream file(path, std::ios::binary | std::ios::ate);
+  if (!file)
+    throw std::runtime_error("cannot open input file: " + path.string());
+  const auto end = file.tellg();
+  if (end < 0 || static_cast<std::uint64_t>(end) > limit)
+    throw std::runtime_error("input file exceeds byte limit: " + path.string());
+  std::vector<std::uint8_t> bytes(static_cast<std::size_t>(end));
+  file.seekg(0);
+  if (!bytes.empty() &&
+      !file.read(reinterpret_cast<char*>(bytes.data()),
+                 static_cast<std::streamsize>(bytes.size()))) {
+    throw std::runtime_error("cannot read complete input file: " +
+                             path.string());
+  }
+  return bytes;
+}
+
+bool AllowedRoute(std::string_view route) {
+  return route == "/v1/chat/completions" || route == "/v1/responses" ||
+         route == "/v1/messages";
+}
+
+bool AllowedBodyField(std::string_view route, std::string_view field) {
+  if (field == "model" || field == "temperature" || field == "cache_prompt")
+    return true;
+  if (route == "/v1/chat/completions") {
+    return field == "messages" || field == "max_tokens" || field == "stream" ||
+           field == "thinking" || field == "chat_template_kwargs" ||
+           field == "stream_options" || field == "top_p" || field == "top_k" ||
+           field == "min_p" || field == "min_keep" || field == "seed" ||
+           field == "repeat_penalty" || field == "repeat_last_n" ||
+           field == "frequency_penalty" || field == "presence_penalty";
+  }
+  if (route == "/v1/responses") {
+    return field == "input" || field == "max_output_tokens" ||
+           field == "stream";
+  }
+  return field == "messages" || field == "max_tokens";
+}
+
+void ValidateTextMessages(const json::Value& messages) {
+  if (!messages.is_array() || messages.empty())
+    throw std::invalid_argument("messages must be a nonempty array");
+  for (const auto& message : messages.items()) {
+    if (!message.is_object() || message.size() != 2 ||
+        !message.contains("role") || !message.contains("content"))
+      throw std::invalid_argument("unknown message option");
+    const auto role = message.member_str("role");
+    const auto* content = message.find("content");
+    if ((role != "user" && role != "assistant" && role != "system") ||
+        content == nullptr || !content->is_string())
+      throw std::invalid_argument("fixture supports text messages only");
+  }
+}
+
+void ValidateBody(std::string_view route, const json::Value& body) {
+  if (!body.is_object())
+    throw std::invalid_argument("request body must be a JSON object");
+  for (const auto& [key, value] : body.members()) {
+    if (!AllowedBodyField(route, key))
+      throw std::invalid_argument("unknown route option: " + key);
+    if (key == "thinking") {
+      if (!value.is_object() || value.size() != 1 ||
+          value.member_str("type") != "disabled")
+        throw std::invalid_argument("thinking must be disabled");
+    }
+    if (key == "chat_template_kwargs") {
+      if (!value.is_object())
+        throw std::invalid_argument("chat_template_kwargs must be an object");
+      for (const auto& [option, setting] : value.members()) {
+        if ((option != "preserve_thinking" && option != "enable_thinking") ||
+            !setting.is_bool() || setting.as_bool())
+          throw std::invalid_argument("unknown or enabled template option");
+      }
+    }
+    if (key == "stream_options") {
+      if (!value.is_object())
+        throw std::invalid_argument("stream_options must be an object");
+      for (const auto& [option, setting] : value.members()) {
+        if (option != "include_usage" || !setting.is_bool())
+          throw std::invalid_argument("unknown stream option");
+      }
+    }
+    if (key == "messages")
+      ValidateTextMessages(value);
+    if (key == "input" && value.is_array())
+      ValidateTextMessages(value);
+  }
+  if (body.member_str("model") != "gufo-flash-next" ||
+      body.member_double("temperature", -1.0) != 0.0 ||
+      body.member_size(route == "/v1/responses" ? "max_output_tokens"
+                                                : "max_tokens") != 64)
+    throw std::invalid_argument(
+        "fixture requires alias, greedy sampling and output 64");
+  const auto* cache = body.find("cache_prompt");
+  if (cache == nullptr || !cache->is_bool() || cache->as_bool())
+    throw std::invalid_argument("fixture requires cache_prompt=false");
+  if (route == "/v1/chat/completions") {
+    const auto* thinking = body.find("thinking");
+    const auto* kwargs = body.find("chat_template_kwargs");
+    if (kwargs == nullptr ||
+        (thinking == nullptr && kwargs->find("enable_thinking") == nullptr))
+      throw std::invalid_argument(
+          "chat fixture must explicitly disable thinking");
+  }
+}
