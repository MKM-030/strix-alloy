@@ -0,0 +1,55 @@
+#ifndef GUFO_SERVER_TEXT_REQUEST_LIMITS_HPP_
+#define GUFO_SERVER_TEXT_REQUEST_LIMITS_HPP_
+
+#include <cstddef>
+#include <cstdint>
+#include <stdexcept>
+
+namespace gufo::server {
+
+enum class TextRequestPolicy : std::uint8_t { kDefault, kAr4kServiceV1 };
+
+inline bool IsAr4kService(TextRequestPolicy policy) noexcept {
+  return policy == TextRequestPolicy::kAr4kServiceV1;
+}
+
+inline void ValidateServiceGeometry(TextRequestPolicy policy,
+                                    std::size_t context, std::size_t sessions,
+                                    std::size_t pending,
+                                    std::size_t pending_per_client) {
+  if (IsAr4kService(policy) && (context != 4096 || sessions != 1 ||
+                                pending != 1 || pending_per_client != 1)) {
+    throw std::invalid_argument(
+        "ar4k-service-v1 requires context=4096, sessions=1, "
+        "pending=1 and pending-per-client=1");
+  }
+}
+
+inline void ValidateRequestedOutput(TextRequestPolicy policy,
+                                    std::size_t output) {
+  if (IsAr4kService(policy) && (output == 0 || output > 256)) {
+    throw std::invalid_argument(
+        "ar4k-service-v1 requires requested output in [1,256]");
+  }
+}
+
+inline void ValidatePreparedRequest(TextRequestPolicy policy, std::size_t input,
+                                    std::size_t output, std::size_t context,
+                                    bool cache_prompt) {
+  if (!IsAr4kService(policy))
+    return;
+  ValidateRequestedOutput(policy, output);
+  if (context != 4096)
+    throw std::invalid_argument("ar4k-service-v1 requires context=4096");
+  if (cache_prompt)
+    throw std::invalid_argument("ar4k-service-v1 forbids cache lookup");
+  if (input == 0 || input > 2304)
+    throw std::length_error(
+        "ar4k-service-v1 requires rendered input in [1,2304]");
+  if (input >= context || output > context - input)
+    throw std::length_error("requested generation exceeds context");
+}
+
+}  // namespace gufo::server
+
+#endif  // GUFO_SERVER_TEXT_REQUEST_LIMITS_HPP_
diff --git a/src/cli/serve/text_request_policy.hpp b/src/cli/serve/text_request_policy.hpp
new file mode 100644
index 0000000..add0279
--- /dev/null
+++ b/src/cli/serve/text_request_policy.hpp
@@ -0,0 +1,89 @@
+#ifndef GUFO_SERVER_TEXT_REQUEST_POLICY_HPP_
+#define GUFO_SERVER_TEXT_REQUEST_POLICY_HPP_
+
+#include <cmath>
+#include <initializer_list>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "src/cli/serve/text_generation_backend.hpp"
+#include "src/cli/serve/text_model_runner.hpp"
+#include "src/cli/serve/text_request_limits.hpp"
+#include "src/core/json.hpp"
+
+namespace gufo::server {
+
+inline void ValidateChatFeatures(TextRequestPolicy policy,
+                                 const ChatRequest& request) {
+  if (!IsAr4kService(policy))
+    return;
+  if (request.cache_prompt)
+    throw std::invalid_argument("ar4k-service-v1 forbids cache lookup");
+  if (request.add_vision_id)
+    throw std::invalid_argument("ar4k-service-v1 forbids vision");
+  if (request.reasoning.enabled != std::optional<bool>{false} ||
+      request.reasoning.preserve_thinking != std::optional<bool>{false} ||
+      request.reasoning.effort.has_value())
+    throw std::invalid_argument("ar4k-service-v1 requires thinking off");
+  for (const auto& message : request.messages) {
+    if (!message.images.empty())
+      throw std::invalid_argument("ar4k-service-v1 forbids vision");
+    if (!message.thought.empty())
+      throw std::invalid_argument("ar4k-service-v1 forbids reasoning history");
+  }
+}
+
+inline std::optional<TextPreparedPrompt> PreparePolicyChatPrompt(
+    TextRequestPolicy policy, const TextModelRunner& runner,
+    const ChatRequest& request, std::size_t output) {
+  ValidateChatFeatures(policy, request);
+  ValidateRequestedOutput(policy, output);
+  auto prepared = runner.PreparePrompt(request);
+  if (IsAr4kService(policy)) {
+    ValidatePreparedRequest(policy, prepared ? prepared->tokens.size() : 0,
+                            output, runner.Descriptor().max_context,
+                            request.cache_prompt);
+  }
+  return prepared;
+}
+
+inline std::vector<TextRunnerToken> PreparePolicyCompletionPrompt(
+    TextRequestPolicy policy, const TextModelRunner& runner,
+    std::string_view prompt) {
+  if (IsAr4kService(policy))
+    throw std::invalid_argument(
+        "ar4k-service-v1 requires a framed chat/responses/messages route");
+  return runner.Tokenize(prompt);
+}
+
+inline std::optional<std::string> ValidateServiceHttpFields(
+    TextRequestPolicy policy, const json::Value& body,
+    std::initializer_list<std::string_view> output_fields) {
+  if (!IsAr4kService(policy))
+    return std::nullopt;
+  std::optional<std::size_t> seen;
+  for (const auto field : output_fields) {
+    const auto* value = body.find(std::string(field));
+    if (value == nullptr || value->is_null())
+      continue;
+    const double number = value->is_number() ? value->as_double() : 0.0;
+    if (!value->is_number() || !std::isfinite(number) ||
+        std::floor(number) != number || number < 1 || number > 256)
+      return "ar4k-service-v1 requires requested output in [1,256]";
+    const auto count = static_cast<std::size_t>(number);
+    if (seen && *seen != count)
+      return "ar4k-service-v1 forbids conflicting output token aliases";
+    seen = count;
+  }
+  if (const auto* cache = body.find("cache_prompt");
+      cache && (!cache->is_bool() || cache->as_bool()))
+    return "ar4k-service-v1 requires cache_prompt=false";
+  return std::nullopt;
+}
+
+}  // namespace gufo::server
+
+#endif  // GUFO_SERVER_TEXT_REQUEST_POLICY_HPP_
