+class PreparationBackend final : public server::TextGenerationBackend {
+public:
+  explicit PreparationBackend(const tokenization::QwenTokenizer* tokenizer)
+      : runner(tokenizer) {}
+  std::string model_id() const override { return "gufo-flash-next"; }
+  bool ready() const override { return true; }
+  server::TextRequestPolicy request_policy() const noexcept override {
+    return server::TextRequestPolicy::kAr4kServiceV1;
+  }
+  SamplingDefaults sampling_defaults() const override {
+    SamplingDefaults defaults;
+    defaults.max_tokens = 64;
+    return defaults;
+  }
+  ReasoningOptions reasoning_defaults() const override {
+    ReasoningOptions options;
+    options.enabled = false;
+    options.preserve_thinking = false;
+    return options;
+  }
+  Result complete(std::string_view, std::size_t,
+                  const sampling::SamplingConfig&, const CancellationCheck&,
+                  const TokenCallback&, std::string_view,
+                  const std::vector<std::string>&) override {
+    throw std::logic_error("offline fixture forbids raw completion");
+  }
+  Result chat(const server::ChatRequest& request, std::size_t max_tokens,
+              const sampling::SamplingConfig&, const CancellationCheck&,
+              const TokenCallback&) override {
+    auto prepared = server::PreparePolicyChatPrompt(request_policy(), runner,
+                                                    request, max_tokens);
+    Result result;
+    result.prompt_tokens = prepared ? prepared->tokens.size() : 0;
+    return result;
+  }
+  std::shared_ptr<GenerationRequest> start_chat(
+      const server::ChatRequest& request, std::size_t max_tokens,
+      const sampling::SamplingConfig& config,
+      const CancellationCheck& cancelled, bool stream) override {
+    (void)server::PreparePolicyChatPrompt(request_policy(), runner, request,
+                                          max_tokens);
+    return TextGenerationBackend::start_chat(request, max_tokens, config,
+                                             cancelled, stream);
+  }
+  std::size_t count_tokens(std::string_view text) const override {
+    return runner.Tokenize(text).size();
+  }
+  PreparationRunner runner;
+};
+
+json::Value ResultFor(const RequestRecord& record,
+                      const tokenization::QwenTokenizer& tokenizer) {
+  PreparationBackend backend(&tokenizer);
+  server::HttpRequest request;
+  request.method = "POST";
+  request.path = record.route;
+  request.body = record.body;
+  const auto response =
+      record.route == "/v1/chat/completions"
+          ? server::HandleOpenAiChat(request, backend)
+          : server::HandleTextCompatibilityRequest(request, backend);
+  json::Value result = json::Value::object();
+  result["id"] = record.id;
+  result["route"] = record.route;
+  result["request_utf8_bytes"] = record.body.size();
+  result["request_sha256"] = Sha256(record.body);
+  result["http_status"] = response.status;
+  const bool prepared = backend.runner.prepare_calls != 0;
+  result["outcome"] = response.status == 200 ? "prepared_offline_route_success"
+                      : prepared             ? "prepared_but_policy_rejected"
+                                             : "rejected_before_preparation";
+  if (response.status != 200)
+    result["route_error"] = response.body;
+  if (prepared && !backend.runner.rendered_prompt.empty()) {
+    result["rendered_utf8_bytes"] = backend.runner.rendered_prompt.size();
+    result["rendered_sha256"] = Sha256(backend.runner.rendered_prompt);
+    result["token_count"] = backend.runner.prepared_tokens.size();
+    result["token_ids_le_u32_sha256"] =
+        TokenIdsSha256(backend.runner.prepared_tokens);
+    result["reasoning_enabled"] =
+        backend.runner.captured.reasoning.enabled.value_or(true);
+    result["preserve_thinking"] =
+        backend.runner.captured.reasoning.preserve_thinking.value_or(true);
+    result["cache_prompt"] = backend.runner.captured.cache_prompt;
+    result["tool_count"] = backend.runner.captured.tools.size();
+    result["tool_choice"] = "auto";
+  }
+  const auto body = json::parse(record.body);
+  const auto* stream = body.find("stream");
+  result["stream"] = stream != nullptr && stream->as_bool();
+  result["temperature"] = body.member_double("temperature");
+  result["max_output_tokens"] = body.member_size(
+      record.route == "/v1/responses" ? "max_output_tokens" : "max_tokens");
+  return result;
+}
+}  // namespace
