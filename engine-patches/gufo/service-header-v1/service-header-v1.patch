+std::vector<RequestRecord> ParseFixture(std::string_view bytes) {
+  if (bytes.size() > kFixtureLimit)
+    throw std::invalid_argument("fixture exceeds 1 MiB");
+  const auto document = json::parse(bytes);
+  const auto* requests = document.find("requests");
+  if (!document.is_object() || document.size() != 1 || requests == nullptr ||
+      !requests->is_array() || requests->empty() || requests->size() > 64)
+    throw std::invalid_argument("fixture requires 1 to 64 requests");
+  std::vector<RequestRecord> result;
+  result.reserve(requests->size());
+  for (const auto& item : requests->items()) {
+    if (!item.is_object() || item.size() != 3)
+      throw std::invalid_argument("request record requires id, route, body");
+    const auto* id = item.find("id");
+    const auto* route = item.find("route");
+    const auto* body = item.find("body");
+    if (id == nullptr || !id->is_string() || id->str().empty() ||
+        route == nullptr || !route->is_string() ||
+        !AllowedRoute(route->str()) || body == nullptr || !body->is_string() ||
+        body->str().size() > kBodyLimit)
+      throw std::invalid_argument("invalid request record or body bound");
+    ValidateBody(route->str(), json::parse(body->str()));
+    result.push_back({id->str(), route->str(), body->str()});
+  }
+  return result;
+}
+
+std::vector<std::uint8_t> ReadAuthenticatedMetadata(
+    const std::filesystem::path& path, std::string_view expected_sha256) {
+  if (expected_sha256.size() != 64 ||
+      !std::all_of(expected_sha256.begin(), expected_sha256.end(),
+                   [](unsigned char c) { return std::isxdigit(c) != 0; }))
+    throw std::invalid_argument(
+        "expected metadata SHA-256 must be 64 hex digits");
+  auto bytes = ReadBounded(path, kMetadataLimit);
+  std::string expected(expected_sha256);
+  std::transform(
+      expected.begin(), expected.end(), expected.begin(),
+      [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+  if (crypto::Sha256Hex(bytes) != expected)
+    throw std::invalid_argument("metadata SHA-256 mismatch");
+  return bytes;
+}
+
+std::string TokenIdsSha256(std::span<const std::uint32_t> tokens) {
+  std::vector<std::uint8_t> bytes;
+  bytes.reserve(tokens.size() * 4);
+  for (const auto token : tokens) {
+    for (unsigned shift = 0; shift < 32; shift += 8)
+      bytes.push_back(static_cast<std::uint8_t>(token >> shift));
+  }
+  return crypto::Sha256Hex(bytes);
+}
+
+bool PreparationOnlyRunnerRejectsInference() {
+  PreparationRunner runner(nullptr);
+  try {
+    (void)runner.CreateState();
+  } catch (const std::logic_error&) {
+    return true;
+  }
+  return false;
+}
+
+std::string PrepareRecord(const RequestRecord& record,
+                          const tokenization::QwenTokenizer& tokenizer) {
+  return ResultFor(record, tokenizer).dump();
+}
+
+std::string PrepareFixture(const std::filesystem::path& metadata_path,
+                           const std::filesystem::path& fixture_path,
+                           std::string_view expected_metadata_sha256) {
+  auto fixture_bytes = ReadBounded(fixture_path, kFixtureLimit);
+  const auto fixture_text =
+      std::string_view(reinterpret_cast<const char*>(fixture_bytes.data()),
+                       fixture_bytes.size());
+  const auto records = ParseFixture(fixture_text);
+  auto metadata =
+      ReadAuthenticatedMetadata(metadata_path, expected_metadata_sha256);
+  std::string error;
+  auto reader =
+      core::GgufReader::OpenMemory(metadata.data(), metadata.size(), &error);
+  if (!reader)
+    throw std::runtime_error("metadata parse failed: " + error);
+  if (!tokenization::QwenChatTemplate::ValidateGgufTemplate(*reader, &error))
+    throw std::runtime_error("unrecognized model template: " + error);
+  auto chat_template =
+      tokenization::QwenChatTemplate::CreateFromGguf(*reader, &error);
+  if (!chat_template)
+    throw std::runtime_error("template creation failed: " + error);
+  auto tokenizer = tokenization::QwenTokenizer::CreateFromGguf(*reader, &error);
+  if (!tokenizer)
+    throw std::runtime_error("tokenizer creation failed: " + error);
+  json::Value report = json::Value::object();
+  report["mode"] = "offline_route_preparation_only";
+  report["metadata_path"] = metadata_path.string();
+  report["metadata_bytes"] = metadata.size();
+  report["metadata_sha256"] = crypto::Sha256Hex(metadata);
+  report["fixture_path"] = fixture_path.string();
+  report["fixture_bytes"] = fixture_bytes.size();
+  report["fixture_sha256"] = crypto::Sha256Hex(fixture_bytes);
+  report["template_id"] = std::string(chat_template->GetTemplateId());
+  report["template_sha256"] = std::string(chat_template->GetTemplateSha256());
+  report["requests"] = json::Value::array();
+  for (const auto& record : records)
+    report["requests"].push_back(ResultFor(record, *tokenizer));
+  return report.dump();
+}
