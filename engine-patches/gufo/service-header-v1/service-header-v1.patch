+void TestServiceSubmitRejectsBeforeAdmission() {
+  auto control = std::make_shared<FakeControl>();
+  control->max_context = 4096;
+  auto scheduler = MakeScheduler(control, 1, {}, ServicePolicy());
+  Expect(scheduler->request_policy() == TextRequestPolicy::kAr4kServiceV1,
+         "scheduler exposes stored request policy");
+  const auto baseline = control->states_created.load(std::memory_order_relaxed);
+  const auto refuse = [&](std::size_t input, std::size_t output,
+                          bool cache_prompt) {
+    auto metadata = ServiceMetadata();
+    metadata.cache_prompt = cache_prompt;
+    ExpectInvalid(
+        [&] {
+          (void)scheduler->Submit(std::vector<TextRunnerToken>(input, 7),
+                                  output, 0.0F, {}, false, metadata);
+        },
+        "invalid service submission is rejected synchronously");
+    Expect(control->states_created.load(std::memory_order_relaxed) == baseline,
+           "refused request creates no state");
+    Expect(control->Events().empty(), "refused request reaches no runner work");
+    Expect(control->decode_calls.load(std::memory_order_relaxed) == 0,
+           "refused request decodes no tokens");
+  };
+  refuse(2305, 256, false);
+  refuse(2304, 257, false);
+  refuse(2304, 0, false);
+  refuse(2304, 256, true);
+
+  auto accepted = scheduler->Submit(std::vector<TextRunnerToken>(2304, 7), 256,
+                                    0.0F, {}, false, ServiceMetadata());
+  const auto result = accepted.Wait();
+  const auto events = control->Events();
+  Expect(!events.empty() && events.front().kind == EventKind::kPrefill &&
+             events.front().count == 2304,
+         "accepted service request prefills all 2304 tokens");
+  Expect(result.prompt_tokens == 2304 && result.tokens.size() == 256,
+         "accepted service request retains its 256-token output limit");
+
+  auto wrong_context = std::make_shared<FakeControl>();
+  wrong_context->max_context = 4095;
+  auto pool = std::make_shared<TextRunnerPool>(
+      std::make_shared<FakeRunner>(wrong_context), 1);
+  const auto wrong_context_baseline =
+      wrong_context->states_created.load(std::memory_order_relaxed);
+  ExpectInvalid(
+      [&] {
+        (void)std::make_unique<TextGenerationScheduler>(
+            pool, TextPrefillPolicy{}, ServicePolicy());
+      },
+      "service scheduler rejects incorrect context at construction");
+  Expect(wrong_context->states_created.load(std::memory_order_relaxed) ==
+                 wrong_context_baseline &&
+             wrong_context->Events().empty() &&
+             wrong_context->decode_calls.load(std::memory_order_relaxed) == 0,
+         "invalid service geometry starts no model work");
+}
