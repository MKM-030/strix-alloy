+        const auto response = Route("/v1/chat/completions", body, backend);
+        const bool refused = response.status == 400 &&
+                             !response.streaming_body &&
+                             backend.runner.prepare_calls == before_prepare &&
+                             backend.admitted_calls == before_admitted;
+        if (!refused)
+          std::cerr << "Explicit effort admitted: kwargs=" << kwargs
+                    << ", effort=" << effort << ", stream=" << stream
+                    << ", status=" << response.status << '\n';
+        all_refused &= refused;
+      }
+    }
+  }
+  auto null_effort = base;
+  null_effort["reasoning_effort"] = gufo::json::Value();
+  Expect(Route("/v1/chat/completions", null_effort, backend).status == 200,
+         "top-level null effort remains an omitted control");
+  null_effort["stream"] = true;
+  Expect(Route("/v1/chat/completions", null_effort, backend).status == 200,
+         "top-level null effort remains omitted for streamed chat");
+  auto nested_null = base;
+  nested_null["chat_template_kwargs"]["reasoning_effort"] = gufo::json::Value();
+  for (const auto policy :
+       {TextRequestPolicy::kDefault, TextRequestPolicy::kAr4kServiceV1}) {
+    backend.policy = policy;
+    const auto response = Route("/v1/chat/completions", nested_null, backend);
+    Expect(response.status == 400 &&
+               response.body.find("invalid_reasoning") != std::string::npos,
+           "nested null effort retains the existing invalid-type response");
+  }
+  return all_refused;
+}
+
+bool TestCompatibilityReasoningContent() {
+  PolicyBackend backend;
+  bool all_refused = true;
+  for (const auto path : {"/v1/responses", "/v1/messages"}) {
+    auto body = gufo::json::parse(
+        R"({"model":"test-model","messages":[{"role":"assistant","content":"earlier answer","reasoning_content":"hidden thought"},{"role":"user","content":"next"}],"max_tokens":1})");
+    if (std::string_view(path) == "/v1/responses") {
+      body = gufo::json::parse(
+          R"({"model":"test-model","input":[{"role":"assistant","content":"earlier answer","reasoning_content":"hidden thought"},{"role":"user","content":"next"}],"max_output_tokens":1})");
+    }
+    backend.policy = TextRequestPolicy::kDefault;
+    Expect(Route(path, body, backend).status == 200,
+           "unrestricted compatibility route preserves reasoning_content "
+           "behavior");
+    if (std::string_view(path) == "/v1/responses") {
+      body["stream"] = true;
+      Expect(Route(path, body, backend).status == 200,
+             "unrestricted streamed Responses preserves reasoning_content "
+             "behavior");
+    }
+    backend.policy = TextRequestPolicy::kAr4kServiceV1;
+    for (const bool stream : {false, true}) {
+      if (stream && std::string_view(path) != "/v1/responses")
+        continue;
+      if (std::string_view(path) == "/v1/responses")
+        body["stream"] = stream;
+      const auto before_prepare = backend.runner.prepare_calls;
+      const auto before_admitted = backend.admitted_calls;
+      const auto response = Route(path, body, backend);
+      const bool refused = response.status == 400 && !response.streaming_body &&
+                           backend.runner.prepare_calls == before_prepare &&
+                           backend.admitted_calls == before_admitted;
+      if (!refused)
+        std::cerr << "Compatibility reasoning_content admitted: path=" << path
+                  << ", stream=" << stream << ", status=" << response.status
+                  << '\n';
+      all_refused &= refused;
+    }
+  }
+  return all_refused;
+}
+
+}  // namespace
+
+int main() {
+  TestChatPolicy();
+  TestDirectRoutes();
+  TestEmptyResponsesReasoningItems();
+  const bool effort_refused = TestExplicitOffEffortFields();
+  const bool history_refused = TestCompatibilityReasoningContent();
+  Expect(effort_refused && history_refused,
+         "service refuses controls and history before conversion");
+  return 0;
+}
