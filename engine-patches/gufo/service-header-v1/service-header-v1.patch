+class PolicyBackend final : public TextGenerationBackend {
+public:
+  std::string model_id() const override { return "test-model"; }
+  bool ready() const override { return true; }
+  TextRequestPolicy request_policy() const noexcept override { return policy; }
+  SamplingDefaults sampling_defaults() const override {
+    SamplingDefaults defaults;
+    defaults.max_tokens = 256;
+    return defaults;
+  }
+  gufo::ReasoningOptions reasoning_defaults() const override {
+    gufo::ReasoningOptions options;
+    options.enabled = false;
+    options.preserve_thinking = false;
+    return options;
+  }
+  Result complete(std::string_view, std::size_t,
+                  const gufo::sampling::SamplingConfig&,
+                  const CancellationCheck&, const TokenCallback&,
+                  std::string_view, const std::vector<std::string>&) override {
+    ++raw_calls;
+    return {};
+  }
+  Result chat(const ChatRequest& request, std::size_t max_tokens,
+              const gufo::sampling::SamplingConfig&, const CancellationCheck&,
+              const TokenCallback&) override {
+    auto prepared =
+        PreparePolicyChatPrompt(policy, runner, request, max_tokens);
+    ++admitted_calls;
+    last_output = max_tokens;
+    last_cache = request.cache_prompt;
+    Result result;
+    result.prompt_tokens = prepared ? prepared->tokens.size() : 0;
+    return result;
+  }
+  std::shared_ptr<GenerationRequest> start_chat(
+      const ChatRequest& request, std::size_t max_tokens,
+      const gufo::sampling::SamplingConfig& sampling,
+      const CancellationCheck& cancelled, bool stream) override {
+    (void)PreparePolicyChatPrompt(policy, runner, request, max_tokens);
+    return TextGenerationBackend::start_chat(request, max_tokens, sampling,
+                                             cancelled, stream);
+  }
+  std::size_t count_tokens(std::string_view text) const override {
+    return text.size();
+  }
+
+  TextRequestPolicy policy{TextRequestPolicy::kAr4kServiceV1};
+  PreparationRunner runner;
+  int admitted_calls{0};
+  int raw_calls{0};
+  std::size_t last_output{0};
+  bool last_cache{true};
+};
