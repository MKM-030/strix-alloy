+        debug_dump_i32_as_f32(&d, codes_name, codes32.data(), &n, 1);
+
+        // The native graph already retains each named logits tensor as an output.
+        // Only read them after compute and the ordinary native code readback.
+        constexpr int steps = 15;
+        constexpr int vocab = 2048;
+        std::vector<struct ggml_tensor *> retained;
+        for (int i = 0; i < ggml_graph_n_nodes(frame_graph->gf); i++) {
+            struct ggml_tensor * node = ggml_graph_node(frame_graph->gf, i);
+            if (strcmp(ggml_get_name(node), "logits") == 0) {
+                retained.push_back(node);
+            }
+        }
+        bool valid = N == 1 && n_acoustic == steps && cw->vocab_size == vocab &&
+                     retained.size() == steps && retained.back() == frame_graph->logits;
+        for (const struct ggml_tensor * node : retained) {
+            valid = valid && (node->flags & GGML_TENSOR_FLAG_OUTPUT) &&
+                    node->type == GGML_TYPE_F32 && ggml_is_contiguous(node) &&
+                    node->ne[0] == vocab && ggml_nelements(node) == vocab;
+        }
+        if (valid) {
+            std::vector<float> native_logits(steps * vocab);
+            for (int g = 0; g < steps; g++) {
+                ggml_backend_tensor_get(retained[(size_t) g], native_logits.data() + g * vocab,
