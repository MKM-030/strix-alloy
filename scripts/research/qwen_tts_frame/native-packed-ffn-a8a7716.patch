+
+// A single allocation with the original gate rows followed by the original up rows.
+// The model mapping remains valid through wctx_alloc, which uploads both ranges.
+static struct ggml_tensor * code_predictor_pack_gate_up(WeightCtx *         wctx,
+                                                       const GGUFModel &   gf,
+                                                       const char *        gate_name,
+                                                       const char *        up_name,
+                                                       int                 hidden,
+                                                       int                 intermediate) {
+    const struct ggml_tensor * gate = ggml_get_tensor(gf.meta, gate_name);
+    const struct ggml_tensor * up   = ggml_get_tensor(gf.meta, up_name);
+    if (!gate || !up || gate->type != GGML_TYPE_Q8_0 || up->type != GGML_TYPE_Q8_0 ||
+        !ggml_is_matrix(gate) || !ggml_is_matrix(up) || hidden <= 0 || intermediate <= 0 ||
+        gate->ne[0] != hidden || up->ne[0] != hidden ||
+        gate->ne[1] != intermediate || up->ne[1] != intermediate) {
+        return nullptr;
+    }
+
+    const void * gate_data = gf_get_data(gf, gate_name);
+    const void * up_data   = gf_get_data(gf, up_name);
+    if (!gate_data || !up_data) {
+        return nullptr;
+    }
+
+    struct ggml_tensor * packed = ggml_new_tensor_2d(wctx->ctx, GGML_TYPE_Q8_0, gate->ne[0], 2 * gate->ne[1]);
+    ggml_format_name(packed, "%s.packed_gate_up", gate_name);
+    const size_t gate_bytes = ggml_nbytes(gate);
+    wctx->pending.push_back({ packed, gate_data, gate_bytes, 0 });
+    wctx->pending.push_back({ packed, up_data, ggml_nbytes(up), gate_bytes });
+    return packed;
+}
 
