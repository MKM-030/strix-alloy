+// [TAG_SAMPLER_KEEP_RESERVE] the samplers of a backend chain, in order: two chains with the same signature add the
+// same operations to the graph, so the compute buffers reserved for one fit the other
+static std::string llama_sampler_chain_signature(llama_sampler * chain) {
+    std::string sig;
+    const int32_t n = llama_sampler_chain_n(chain);
+    for (int32_t i = 0; i < n; ++i) {
+        sig += llama_sampler_name(llama_sampler_chain_get(chain, i));
+        sig += '|';
+    }
+    return sig;
+}
+
 bool llama_context::set_sampler(llama_seq_id seq_id, llama_sampler * sampler) {
     if (!sampler && sampling.samplers.count(seq_id) == 0) {
         return true;
     }
 
+    // [TAG_SAMPLER_KEEP_RESERVE] LLAMA_SAMPLER_KEEP_RESERVE=1 explicitly enables reuse; unset keeps the old behavior
+    static const bool keep_reserve = [] {
+        const char * value = getenv("LLAMA_SAMPLER_KEEP_RESERVE");
+        return value != nullptr && std::strcmp(value, "1") == 0;
+    }();
+
     LLAMA_LOG_DEBUG("%s: seq_id = %d, sampler = %p\n", __func__, (int) seq_id, (void *) sampler);
 
