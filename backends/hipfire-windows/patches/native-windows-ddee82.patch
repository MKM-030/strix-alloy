+/// Physical and commit headroom retained for other host allocations on Windows.
+pub const WINDOWS_HOST_RESERVE_BYTES: u64 = 18 << 30;
+
+/// Conservative Windows host allocation budget from a calling-process
+/// `GlobalMemoryStatusEx` snapshot. Missing or inconsistent physical/commit
+/// values refuse admission; zero availability is a valid exhausted budget.
+/// Pagefile capacity never adds physical capacity, and Linux CMA/TTM estimates
+/// do not apply. The caller must obtain the snapshot in the allocating process.
+/// Physical or commit availability at/below 18 GiB has zero allowance.
+pub fn windows_host_allocation_budget(memory: hipfire_config::HostMemory) -> Option<u64> {
+    if memory.source != hipfire_config::host_memory::SOURCE_GLOBAL_MEMORY_STATUS_EX
+        || memory.total_physical_bytes == 0
+        || memory.available_physical_bytes > memory.total_physical_bytes
+    {
+        return None;
+    }
+    let commit_limit = memory.commit_limit_bytes?;
+    let commit_available = memory.commit_available_bytes?;
+    if commit_available > commit_limit {
+        return None;
+    }
+    Some(memory.available_physical_bytes
+        .saturating_sub(WINDOWS_HOST_RESERVE_BYTES)
+        .min(commit_available.saturating_sub(WINDOWS_HOST_RESERVE_BYTES)))
+}
+
+/// Windows UMA device allowance, retaining an independent host reserve even
+/// when the firmware-dedicated pool is proven. Identity/counter failure falls
+/// back to the reserved host allowance; it never credits shared GPU memory.
+#[cfg(windows)]
+pub fn windows_device_free_bytes(
+    hip: &hip_bridge::HipRuntime,
+    device_id: i32,
+    hip_free: u64,
+    hip_total: u64,
+) -> hip_bridge::HipResult<u64> {
+    use hipfire_config::host_memory::{amd_adapters, dedicated_usage, dxgi_adapter_budgets};
+
+    let host_allowance = hipfire_config::host_memory()
+        .and_then(windows_host_allocation_budget)
+        .ok_or_else(|| hip_bridge::HipError::new(0, host_available_error()))?;
+    // Includes physical availability at/below the reserve and exhausted commit.
+    // Dedicated capacity cannot cancel this host admission check.
+    if host_allowance == 0 {
+        return Ok(0);
+    }
+    let dedicated = || -> Result<u64, String> {
+        let (luid, node_mask) = hip.windows_device_luid(device_id)
+            .map_err(|error| error.to_string())?;
+        // HIP 7.2 on the qualified gfx1151 integrated single-visible-device
+        // tuple leaves its mask zero. Root observed a real HIP allocation
+        // charged to this exact LUID's DXGI LOCAL node 0 and PDH phys_0.
+        // Preserve this narrow qualified exception; other zero/multi-node
+        // masks cannot authorize dedicated capacity.
+        let qualified_zero_mask = if node_mask == 0 {
+            hip.device_count().map_err(|error| error.to_string())? == 1
+                && hip.get_arch(device_id).map_err(|error| error.to_string())? == "gfx1151"
+                && hip.get_device_attribute(crate::dispatch::HIP_DEVICE_ATTRIBUTE_INTEGRATED, device_id)
+                    .map_err(|error| error.to_string())? != 0
+        } else {
+            false
+        };
+        if luid == [0; 8] || (node_mask != 1 && !qualified_zero_mask) {
+            return Err(format!(
+                "HIP R0600 cannot prove one node-0 adapter: LUID {luid:02x?}, node mask 0x{node_mask:08x}"
+            ));
+        }
+        let adapters = dxgi_adapter_budgets().map_err(|error| error.to_string())?;
+        let mut matching = amd_adapters(&adapters).filter(|adapter| adapter.matches_luid(&luid));
+        let adapter = matching.next().ok_or_else(|| "no exact AMD DXGI LUID match".to_string())?;
+        if matching.next().is_some() || adapter.node_index != 0 {
+            return Err("ambiguous DXGI adapter or unsupported physical node".into());
+        }
+        if adapter.dedicated_video_memory_bytes == 0 {
+            return Err("exact DXGI adapter reports no dedicated video memory".into());
+        }
+        let global = dedicated_usage(luid, adapter.node_index)?;
+        let free = hip_free.min(hip_total)
+            .min(adapter.dedicated_video_memory_bytes.saturating_sub(global.bytes))
+            .min(adapter.local.budget_bytes.saturating_sub(adapter.local.current_usage_bytes));
+        static REPORTED: std::sync::Once = std::sync::Once::new();
+        REPORTED.call_once(|| eprintln!(
+            "[memory] Windows dedicated budget: {} path={} node_mask=0x{node_mask:08x} qualified_zero_mask={qualified_zero_mask} dedicated={} global_usage={} local_budget={} process_usage={} hip_free={} gpu_free={} host_allowance={} host_reserve={}",
+            global.source, global.counter_path, adapter.dedicated_video_memory_bytes,
+            global.bytes, adapter.local.budget_bytes, adapter.local.current_usage_bytes,
+            hip_free, free, host_allowance, WINDOWS_HOST_RESERVE_BYTES,
+        ));
+        Ok(free)
+    };
+    match dedicated() {
+        Ok(free) => Ok(free),
+        Err(error) => {
+            static REPORTED: std::sync::Once = std::sync::Once::new();
+            REPORTED.call_once(|| eprintln!(
+                "[memory] Windows dedicated budget unavailable: {error}; using host physical/commit allowance after 18 GiB reserve"
+            ));
+            Ok(hip_free.min(hip_total).min(host_allowance))
+        }
+    }
+}
