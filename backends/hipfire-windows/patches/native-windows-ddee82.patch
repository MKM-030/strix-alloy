+/// Adapter-global dedicated usage, not the calling process's DXGI usage.
+#[cfg(windows)]
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct DedicatedUsage {
+    pub luid: [u8; 8],
+    pub node_index: u32,
+    pub bytes: u64,
+    pub counter_path: String,
+    pub counter_type: u32,
+    pub counter_status: u32,
+    pub source: &'static str,
+}
+
+/// Read one exact node-0 adapter's live PDH Dedicated Usage gauge. Missing
+/// instances and invalid samples are errors, never zero usage. The query is
+/// local to this call; no spawned process, wildcard or per-process sum is used.
+#[cfg(windows)]
+pub fn dedicated_usage(luid: [u8; 8], node_index: u32) -> Result<DedicatedUsage, String> {
+    use windows::core::PCWSTR;
+    use windows::Win32::System::Performance::{
+        PdhAddEnglishCounterW, PdhCloseQuery, PdhCollectQueryData,
+        PdhGetFormattedCounterValue, PdhOpenQueryW, PDH_CSTATUS_NEW_DATA,
+        PDH_CSTATUS_VALID_DATA, PDH_FMT, PDH_FMT_COUNTERVALUE, PDH_FMT_LARGE,
+        PDH_HCOUNTER, PDH_HQUERY,
+    };
+
+    if luid == [0; 8] || node_index != DXGI_QUERIED_NODE_INDEX {
+        return Err("PDH dedicated usage requires a nonzero LUID and node 0".into());
+    }
+    let low = u32::from_le_bytes(luid[..4].try_into().expect("four LUID bytes"));
+    let high = u32::from_le_bytes(luid[4..].try_into().expect("four LUID bytes"));
+    let counter_path = format!(
+        "\\GPU Adapter Memory(luid_0x{high:08x}_0x{low:08x}_phys_{node_index})\\Dedicated Usage"
+    );
+    let check = |operation: &str, status: u32| -> Result<(), String> {
+        if status == 0 {
+            Ok(())
+        } else {
+            Err(format!("{operation}({counter_path}) failed: PDH status 0x{status:08x}"))
+        }
+    };
+    struct Query(PDH_HQUERY);
+    impl Drop for Query {
+        fn drop(&mut self) {
+            if !self.0.is_invalid() {
+                // SAFETY: this guard owns the successfully opened query.
+                // Closing also removes its counters on every error path.
+                unsafe { PdhCloseQuery(self.0) };
+            }
+        }
+    }
+    let mut handle = PDH_HQUERY::default();
+    // SAFETY: null source selects live local counters; handle is writable.
+    check("PdhOpenQueryW", unsafe { PdhOpenQueryW(PCWSTR::null(), 0, &mut handle) })?;
+    if handle.is_invalid() {
+        return Err(format!("PdhOpenQueryW({counter_path}) returned a null query"));
+    }
+    let mut query = Query(handle);
+    let wide: Vec<u16> = counter_path.encode_utf16().chain(std::iter::once(0)).collect();
+    let mut counter = PDH_HCOUNTER::default();
+    // SAFETY: query is owned here, path is NUL-terminated and counter writable.
+    check("PdhAddEnglishCounterW", unsafe {
+        PdhAddEnglishCounterW(query.0, PCWSTR(wide.as_ptr()), 0, &mut counter)
+    })?;
+    // SAFETY: the query and its exact counter remain live.
+    check("PdhCollectQueryData", unsafe { PdhCollectQueryData(query.0) })?;
+    let mut value = PDH_FMT_COUNTERVALUE::default();
+    let mut counter_type = 0;
+    // PDH_FMT_NOSCALE (pdh.h) is omitted from windows 0.62.2's bindings.
+    // It preserves the Dedicated Usage gauge's native byte unit.
+    const FMT_NOSCALE: u32 = 0x0000_1000;
+    // SAFETY: FMT_LARGE selects the largeValue union member; all output
+    // pointers are live. AddCounter success alone does not validate an instance.
+    let status = unsafe {
+        PdhGetFormattedCounterValue(
+            counter, PDH_FMT(PDH_FMT_LARGE.0 | FMT_NOSCALE),
+            Some(&mut counter_type), &mut value,
+        )
+    };
+    if status != 0 || !matches!(value.CStatus, PDH_CSTATUS_VALID_DATA | PDH_CSTATUS_NEW_DATA) {
+        return Err(format!(
+            "PdhGetFormattedCounterValue({counter_path}) failed: PDH status 0x{status:08x}, CStatus 0x{:08x}, type 0x{counter_type:08x}",
+            value.CStatus,
+        ));
+    }
+    // SAFETY: the successful call used FMT_LARGE and returned valid data.
+    let bytes = unsafe { value.Anonymous.largeValue };
+    if bytes < 0 {
+        return Err(format!("PDH Dedicated Usage({counter_path}) is negative: {bytes}"));
+    }
+    // SAFETY: this guard still owns the query. Check the normal close status;
+    // Drop retains cleanup responsibility if closing reports an error.
+    let close_status = unsafe { PdhCloseQuery(query.0) };
+    if close_status == 0 {
+        query.0 = PDH_HQUERY::default();
+    }
+    check("PdhCloseQuery", close_status)?;
+    Ok(DedicatedUsage {
+        luid, node_index, bytes: bytes as u64, counter_path, counter_type,
+        counter_status: value.CStatus,
+        source: "PDH GPU Adapter Memory Dedicated Usage (adapter global)",
+    })
+}
