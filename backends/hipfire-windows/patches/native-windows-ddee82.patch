+
+use super::*;
+use crate::ple_hot_pack::table_support::write_test_table;
+use crate::ple_hot_store::test_support::{synthetic_buckets, synthetic_shards};
+
+#[test]
+fn exact_loop_retries_interruptions_and_short_reads_at_advancing_offsets() {
+    let mut output = [0; 5];
+    let mut calls = Vec::new();
+    let mut interrupted = false;
+    read_exact_at_with(1u64 << 33, &mut output, |dst, at| {
+        calls.push(at);
+        if !interrupted {
+            interrupted = true;
+            return Err(io::ErrorKind::Interrupted.into());
+        }
+        let n = dst.len().min(2);
+        for (i, value) in dst[..n].iter_mut().enumerate() {
+            *value = (at + i as u64) as u8;
+        }
+        Ok(n)
+    }).unwrap();
+    assert_eq!(calls, [1u64 << 33, 1u64 << 33, (1u64 << 33) + 2, (1u64 << 33) + 4]);
+    assert_eq!(output, [0, 1, 2, 3, 4]);
+}
+
+#[test]
+fn exact_loop_reports_partial_eof_io_offset_and_overflow() {
+    let mut output = [0; 4];
+    let error = read_exact_at_with(17, &mut output, |dst, at| {
+        if at == 17 { dst[..2].fill(7); Ok(2) } else { Ok(0) }
+    }).unwrap_err();
+    assert!(matches!(error, SourceError::ShortRead { offset: 17, expected: 4, actual: 2 }));
+    let error = read_exact_at_with(17, &mut output, |_, at| {
+        if at == 17 { Ok(2) } else { Err(io::ErrorKind::PermissionDenied.into()) }
+    }).unwrap_err();
+    assert!(matches!(error, SourceError::Io { offset: 19, .. }));
+    let error = read_exact_at_with(u64::MAX - 1, &mut output, |_, _| panic!("overflow must not read")).unwrap_err();
+    assert!(matches!(error, SourceError::Overflow { .. }));
+    read_exact_at_with(u64::MAX, &mut [], |_, _| panic!("empty must not read")).unwrap();
+}
+
+#[test]
+fn rank_table_serves_exact_rows_concurrently_without_workers() {
+    const RPS: usize = 64;
+    let shards = std::sync::Arc::new(synthetic_shards(3, RPS));
+    let buckets = synthetic_buckets(3 * RPS, 17);
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("rank.ple-q8");
+    write_test_table(&path, PackOrder::Rank, RowEncoding::Q8F16, 160, RPS, &shards, Some(&buckets), DEFAULT_TIER_BUCKETS);
+    let store = HotRowStore::open_table(&path).unwrap();
+    assert!(store.is_serving());
+    assert_eq!(store.load_filled_bytes(), 0);
+    assert_eq!(store.prewarmed_bytes(), 0);
+    let threads: Vec<_> = (0..8).map(|worker| {
+        let store = store.clone();
+        let shards = shards.clone();
+        std::thread::spawn(move || {
+            for index in 0..192 {
+                let row = (index * 31 + worker * 7) % (3 * RPS);
+                let mut got = [0; ENCODED_ROW_BYTES];
+                store.read_pack(store.pack_offset(row as u64).unwrap(), &mut got).unwrap();
+                let start = (row % RPS) * ENCODED_ROW_BYTES;
+                assert_eq!(got.as_slice(), &shards[row / RPS][start..start + ENCODED_ROW_BYTES]);
+            }
+        })
+    }).collect();
+    for thread in threads { thread.join().unwrap(); }
+    let mut byte = [0];
+    assert!(store.read_pack(0, &mut byte).is_err());
+    assert!(store.read_pack(u64::MAX, &mut byte).is_err());
+}
+
+#[test]
+fn rank_table_rejects_row_order_corrupt_rank_and_truncated_data() {
+    let shards = synthetic_shards(2, 64);
+    let buckets = synthetic_buckets(128, 3);
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("table.ple-q8");
+    write_test_table(&path, PackOrder::Row, RowEncoding::Q8F16, 160, 64, &shards, None, DEFAULT_TIER_BUCKETS);
+    assert!(HotRowStore::open_table(&path).is_err());
+
+    let header = write_test_table(&path, PackOrder::Rank, RowEncoding::Q8F16, 160, 64, &shards, Some(&buckets), DEFAULT_TIER_BUCKETS);
+    let store = HotRowStore::open_table(&path).unwrap();
+    let row = (0..128).max_by_key(|&row| store.pack_offset(row).unwrap()).unwrap();
+    let at = store.pack_offset(row).unwrap();
+    let file = std::fs::OpenOptions::new().write(true).open(&path).unwrap();
+    file.set_len(at + ENCODED_ROW_BYTES as u64 - 1).unwrap();
+    let mut bytes = [0; ENCODED_ROW_BYTES];
+    assert!(matches!(store.read_pack(at, &mut bytes), Err(SourceError::ShortRead { .. })));
+    drop(file);
+    drop(store);
+
+    write_test_table(&path, PackOrder::Rank, RowEncoding::Q8F16, 160, 64, &shards, Some(&buckets), DEFAULT_TIER_BUCKETS);
+    let mut file = std::fs::OpenOptions::new().write(true).open(&path).unwrap();
+    use std::io::{Seek, SeekFrom};
+    file.seek(SeekFrom::Start(header.rank_offset)).unwrap();
+    file.write_all(&[buckets[0] ^ 1]).unwrap();
+    drop(file);
+    let error = HotRowStore::open_table(&path).err().expect("corrupt rank must refuse");
+    assert!(error.contains("embedded rank sha256"));
+}
