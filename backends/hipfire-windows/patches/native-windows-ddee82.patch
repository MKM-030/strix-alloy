+#[cfg(any(windows, test))]
+fn parse_windows_arch(field: &[u8; 256]) -> HipResult<String> {
+    let invalid = || HipError::new(0, "hipGetDevicePropertiesR0600: invalid bounded gcnArchName");
+    let end = field.iter().position(|&byte| byte == 0).ok_or_else(invalid)?;
+    let name = std::str::from_utf8(&field[..end]).map_err(|_| invalid())?;
+    if !name.is_ascii() || name.bytes().any(|byte| byte.is_ascii_whitespace()) {
+        return Err(invalid());
+    }
+    let arch = name.split(':').next().ok_or_else(invalid)?;
+    let digits = arch.strip_prefix("gfx").ok_or_else(invalid)?;
+    if digits.len() < 3
+        || !digits.bytes().all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    {
+        return Err(invalid());
+    }
+    Ok(arch.to_string())
+}
