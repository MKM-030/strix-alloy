+  float t1 = __fadd_rn(x,1.0f);
+  asm volatile("" : "+v"(t1));
+  float t2 = frexpf(t1, &exponent);
+  asm volatile("" : "+v"(t2));
+  float t3 = __fadd_rn(t1,-1.0f);
+  asm volatile("" : "+v"(t3));
+  const int t4 = exponent - static_cast<int>((t2 < 0x1.5555560000000p-1f));
+  float t5 = __fsub_rn(t3,t1);
+  asm volatile("" : "+v"(t5));
+  const int t6 = -t4;
+  float t7 = __fsub_rn(x,t3);
+  asm volatile("" : "+v"(t7));
+  float t8 = ldexpf(t1,t6);
+  asm volatile("" : "+v"(t8));
+  float t9 = __fadd_rn(t5,1.0f);
+  asm volatile("" : "+v"(t9));
+  float t10 = static_cast<float>(t4);
+  asm volatile("" : "+v"(t10));
+  float t11 = __fadd_rn(t9,t7);
+  asm volatile("" : "+v"(t11));
+  float t12 = __fadd_rn(t8,1.0f);
+  asm volatile("" : "+v"(t12));
+  float t13 = ldexpf(t11,t6);
+  asm volatile("" : "+v"(t13));
+  float t14 = __fadd_rn(t8,-1.0f);
+  asm volatile("" : "+v"(t14));
+  float t15 = __fadd_rn(t12,-1.0f);
+  asm volatile("" : "+v"(t15));
+  float t16 = __fadd_rn(t14,1.0f);
+  asm volatile("" : "+v"(t16));
+  float t17 = __fsub_rn(t8,t15);
+  asm volatile("" : "+v"(t17));
+  float t18 = __fsub_rn(t8,t16);
+  asm volatile("" : "+v"(t18));
+  float t19 = __fadd_rn(t13,t17);
+  asm volatile("" : "+v"(t19));
