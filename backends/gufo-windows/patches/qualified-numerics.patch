+// Derived from ROCm OCML log1pF.cl, lnepF.cl and ep.h. The scalar steps retain
+// the validated FP32/FMA boundaries; all instructions are compiled by the selected SDK.
+// Empty output constraints preserve compensated error terms under fast-math.
+// This positive-domain helper is used only after exp in SoftplusF.
+#pragma once
+namespace alloy_math_compat {
+__device__ __forceinline__ float log1p_positive(float x) {
+#pragma clang fp reassociate(off) contract(off)
+  if (x < 0.0f || !isfinite(x)) return log1pf(x);
+  if (x < 0x1.0p-24f) return x;
+  int exponent = 0;
