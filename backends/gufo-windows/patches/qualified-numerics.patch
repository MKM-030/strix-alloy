+  asm volatile("" : "+v"(t20));
+  float t21 = __fadd_rn(t12,t19);
+  asm volatile("" : "+v"(t21));
+  float t22 = __fadd_rn(t14,t20);
+  asm volatile("" : "+v"(t22));
+  float t23 = __builtin_amdgcn_rcpf(t21);
+  asm volatile("" : "+v"(t23));
+  float t24 = __fsub_rn(t12,t21);
+  asm volatile("" : "+v"(t24));
